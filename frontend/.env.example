# Copy this file to .env and fill in the values. On Vercel, set the same names under
# Project → Settings → Environment Variables. All three are required.
# (VITE_ variables end up in the browser bundle, so never put secret keys here.)

# URL of the FastAPI backend, no trailing slash.
# Local: http://localhost:8000   Production: https://your-service.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase → Project Settings → API Keys (Project URL is under Data API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key (or new "publishable" key, sb_publishable_...). Safe for the browser.
VITE_SUPABASE_ANON_KEY=your-anon-key
