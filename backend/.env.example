# Copy this file to .env and fill in the values. Never commit .env!
# On Render, set the same names under Environment (except the DEMO_ ones).

# Comma-separated website origins allowed to call the API (CORS), no trailing slash.
# Local:      http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase → Project Settings → API Keys (Project URL is under Data API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key (or new "publishable" key, sb_publishable_...), the same one the frontend uses.
# The backend acts as the logged-in user, so Row Level Security always applies.
SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio → Get API key (https://aistudio.google.com/apikey). Server only!
GEMINI_API_KEY=your-gemini-api-key
# "gemini-flash-latest" always points to the newest Flash model. You can pin a specific one,
# e.g. gemini-3.5-flash or gemini-3.5-flash-lite (check the free-tier limits in AI Studio).
GEMINI_MODEL=gemini-flash-latest
# Give up waiting for the AI after this many seconds.
GEMINI_TIMEOUT_SECONDS=60

# Fair use: max receipt scans per user per day.
SCAN_LIMIT_PER_DAY=15

# (scripts/seed_demo.py asks for the demo account's password when it runs;
#  never store it in this file.)
