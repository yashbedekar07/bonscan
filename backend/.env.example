# Copy this file to .env and fill in the values.

# Comma-separated origins allowed to call the API (CORS).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase → Project Settings → API Keys (Project URL is under Data API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key (or new "publishable" key, sb_publishable_...), the same one the frontend uses.
# The backend acts as the logged-in user, so Row Level Security always applies.
SUPABASE_ANON_KEY=your-anon-key

# Google AI Studio → Get API key (https://aistudio.google.com/apikey). Server only, never commit it!
GEMINI_API_KEY=your-gemini-api-key
# "gemini-flash-latest" always points to the newest Flash model. You can pin a specific one,
# e.g. gemini-3.5-flash or gemini-3.5-flash-lite (check the free-tier limits in AI Studio).
GEMINI_MODEL=gemini-flash-latest
# Give up waiting for the AI after this many seconds.
GEMINI_TIMEOUT_SECONDS=60
